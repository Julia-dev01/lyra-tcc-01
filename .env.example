# ==========================================================================
# Alerta Segura - variaveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versione o arquivo .env real.
# ==========================================================================

NODE_ENV=development
PORT=3001
# URL publica do frontend (usada em CORS e links de convite)
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alerta_segura?schema=public

# ---------------------------------------------------------------------------
# Criptografia
# CHAVE_AES: 32 bytes em base64 (AES-256-GCM)
#   gerar com: openssl rand -base64 32
# CHAVE_HMAC: chave do indice cego (blind index) para busca sobre dados cifrados
#   gerar com: openssl rand -base64 32
# ---------------------------------------------------------------------------
CRYPTO_KEY=REPLACE_WITH_BASE64_32_BYTES
BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTES

# ---------------------------------------------------------------------------
# Sessoes / JWT
#   gerar com: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_TTL_USER=5m
ACCESS_TOKEN_TTL_ADMIN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# 2FA (TOTP) - nome exibido no app autenticador
# ---------------------------------------------------------------------------
TOTP_ISSUER=AlertaSegura

# ---------------------------------------------------------------------------
# Super Admin inicial (seeds). Troca de senha obrigatoria no 1o acesso.
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME=Administrador Inicial
SUPER_ADMIN_EMAIL=superadmin@alertasegura.local
SUPER_ADMIN_PASSWORD="AlertaSegura#2026"

# ---------------------------------------------------------------------------
# AlertDispatcher (camada abstrata de notificacao).
# PROVIDER=simulated -> nao envia de verdade, apenas registra a tentativa.
# Para usar Twilio, preencha as credenciais e PROVIDER=twilio.
# ---------------------------------------------------------------------------
ALERT_DISPATCHER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Prazos de retencao do chat anonimo (horas) e politicas
# ---------------------------------------------------------------------------
ANON_CHAT_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Redis opcional (rate limit distribuido / socket adapter)
# ---------------------------------------------------------------------------
REDIS_URL=
